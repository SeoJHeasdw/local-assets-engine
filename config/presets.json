{
  "version": 1,
  "imageModel": {
    "id": "flux2-klein-4b",
    "label": "FLUX.2 klein 4B",
    "command": "mflux-generate-flux2",
    "repo": "black-forest-labs/FLUX.2-klein-4B",
    "license": "Apache-2.0",
    "steps": null,
    "quantize": 8,
    "mlxCacheLimitGb": 8,
    "lowRam": false
  },
  "backgroundRemoval": {
    "repo": "ZhengPeng7/BiRefNet",
    "revision": "e2bf8e4460fc8fa32bba5ea4d94b3233d367b0e4",
    "license": "MIT"
  },
  "mesh": {
    "repo": "microsoft/TRELLIS.2-4B",
    "license": "MIT",
    "pipelineTypes": [
      "512",
      "1024",
      "1024_cascade"
    ],
    "textureSizes": [
      512,
      1024,
      2048
    ],
    "defaults": {
      "pipelineType": "512",
      "textureSize": 1024,
      "targetFaces": 30000,
      "sizeMeters": 1.0
    }
  },
  "previz": {
    "renderers": ["eevee", "workbench", "cycles"],
    "auxModes": ["keys", "all", "none"],
    "defaults": {
      "renderer": "eevee",
      "width": 960,
      "height": 540,
      "fps": 12,
      "samples": 16,
      "aux": "keys",
      "animatic": true,
      "ground": true,
      "clay": true
    },
    "shotPresets": [
      {
        "id": "game-trailer",
        "label": "게임 트레일러",
        "hint": "6컷 15초 · 전경 → 공개 → 앙각 → 디테일 → 하강 → 후퇴",
        "look": {},
        "shots": [
          {
            "id": "s01",
            "label": "전경 소개",
            "purpose": "장소와 크기를 보여 준다",
            "move": "dolly-in",
            "focus": "scene",
            "lens": 28,
            "seconds": 2.5,
            "framing": {
              "distance": 3.2, "distanceEnd": 2.6,
              "azimuth": -35, "height": 1.15, "targetHeight": 0.5
            }
          },
          {
            "id": "s02",
            "label": "주인공 공개",
            "purpose": "대상을 돌며 형태를 보여 준다",
            "move": "orbit",
            "focus": "hero",
            "lens": 50,
            "seconds": 3.0,
            "framing": {
              "distance": 1.7,
              "azimuth": -55, "azimuthEnd": 5,
              "height": 0.8, "targetHeight": 0.55
            }
          },
          {
            "id": "s03",
            "label": "앙각 강조",
            "purpose": "낮은 눈높이로 위압감을 준다",
            "move": "push-in",
            "focus": "hero",
            "lens": 28,
            "seconds": 2.0,
            "framing": {
              "distance": 1.5, "distanceEnd": 1.3,
              "azimuth": 15, "height": 0.12, "targetHeight": 0.8
            }
          },
          {
            "id": "s04",
            "label": "디테일 접근",
            "purpose": "질감·장식을 가까이 본다",
            "move": "push-in",
            "focus": "hero",
            "lens": 85,
            "seconds": 2.0,
            "framing": {
              "distance": 1.1, "distanceEnd": 0.8,
              "azimuth": 25, "height": 0.7, "targetHeight": 0.6,
              "targetOffset": [0.1, 0]
            }
          },
          {
            "id": "s05",
            "label": "하강 이동",
            "purpose": "위에서 눈높이로 내려온다",
            "move": "crane-down",
            "focus": "hero",
            "lens": 35,
            "seconds": 2.5,
            "framing": {
              "distance": 2.2, "distanceEnd": 1.9,
              "azimuth": -20, "azimuthEnd": -5,
              "height": 2.4, "heightEnd": 0.55,
              "targetHeight": 0.55
            }
          },
          {
            "id": "s06",
            "label": "후퇴 마무리",
            "purpose": "물러나며 전체를 남긴다",
            "move": "dolly-out",
            "focus": "scene",
            "lens": 24,
            "seconds": 3.0,
            "framing": {
              "distance": 2.2, "distanceEnd": 4.0,
              "azimuth": 20, "height": 0.85, "targetHeight": 0.45
            }
          }
        ]
      }
    ]
  },
  "presets": [
    {
      "id": "item-icon",
      "kind": "2d",
      "label": "아이템 아이콘",
      "hint": "무기·포션·보석 같은 인벤토리 아이콘",
      "prompt": "{subject}, game item icon, single object centered, clean readable silhouette, soft studio lighting, plain light gray background, no text, no border",
      "width": 1024,
      "height": 1024,
      "removeBackground": true,
      "canvas": {
        "width": 512,
        "height": 512,
        "padding": 0.06
      }
    },
    {
      "id": "character-sprite",
      "kind": "2d",
      "label": "캐릭터 스프라이트",
      "hint": "전신이 보이는 정면 캐릭터",
      "prompt": "{subject}, full body game character, front view, standing pose, entire body visible from head to feet, plain light gray background, no text",
      "width": 768,
      "height": 1024,
      "removeBackground": true,
      "canvas": {
        "width": 768,
        "height": 1024,
        "padding": 0.04
      }
    },
    {
      "id": "pixel-art",
      "kind": "2d",
      "label": "픽셀 아트",
      "hint": "작은 해상도로 줄이고 색 수를 제한",
      "prompt": "{subject}, pixel art game sprite, 16-bit retro style, limited color palette, crisp hard edges, single subject centered, plain light gray background",
      "width": 1024,
      "height": 1024,
      "removeBackground": true,
      "canvas": {
        "width": 512,
        "height": 512,
        "padding": 0.04
      },
      "pixelate": {
        "size": 64,
        "colors": 24
      }
    },
    {
      "id": "ui-element",
      "kind": "2d",
      "label": "UI 요소",
      "hint": "버튼·프레임·배지",
      "prompt": "{subject}, game UI element, polished flat style, centered, plain light gray background, no text, no letters",
      "width": 1024,
      "height": 1024,
      "removeBackground": true,
      "canvas": {
        "width": 512,
        "height": 512,
        "padding": 0.04
      }
    },
    {
      "id": "background",
      "kind": "2d",
      "label": "배경",
      "hint": "캐릭터 없는 가로 배경",
      "prompt": "{subject}, game background art, wide environment scene, detailed, cohesive lighting, no characters, no text",
      "width": 1344,
      "height": 768,
      "removeBackground": false
    },
    {
      "id": "prop-3d",
      "kind": "3d",
      "label": "3D 소품",
      "hint": "컨셉 이미지를 만든 뒤 3D 메시로 변환",
      "prompt": "{subject}, single 3D game prop, stylized with smooth clean surfaces and simple bold shapes, flat even materials, minimal surface texture detail, entire object visible, three-quarter view, centered, soft even lighting, plain white background, no shadow, no text",
      "width": 1024,
      "height": 1024,
      "removeBackground": true,
      "canvas": {
        "width": 1024,
        "height": 1024,
        "padding": 0.08
      }
    }
  ]
}
